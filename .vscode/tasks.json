{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Install on connected phone",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug",
      "problemMatcher": []
    },
    {
      "label": "List connected phones",
      "type": "shell",
      "command": "adb devices -l",
      "problemMatcher": []
    },
    {
      "label": "Show warnings and errors (logcat)",
      "type": "shell",
      "command": "adb logcat *:W",
      "problemMatcher": []
    }
  ]
}
